<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hotspot Optimizer"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="MAX mode - reduces radios, noise and battery drain.\nDoes NOT increase signal strength."
            android:textSize="13sp"
            android:gravity="center"
            android:textColor="#666666" />

        <TextView
            android:id="@+id/tvBluetoothStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Bluetooth: -"
            android:textSize="16sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvDndStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Do Not Disturb: -"
            android:textSize="16sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvNfcStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="NFC: -"
            android:textSize="16sp"
            android:gravity="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOptimize"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="28dp"
            android:text="MAX OPTIMIZE NOW"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Manual tools (tap to open)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGrantDnd"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Grant Do Not Disturb Access" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenAppSettings"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Force-stop Apps" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLocationSettings"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Turn Location / GPS OFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNfcSettings"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Turn NFC OFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBatterySettings"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Battery Saver" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWifiSettings"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Wi-Fi Settings (channel / band)" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDisplaySettings"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Display Settings (brightness)" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeveloperOptions"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Developer Options (Stay Awake)" />

    </LinearLayout>
</ScrollView>
